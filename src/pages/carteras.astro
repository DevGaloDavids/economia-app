---
import TarjetaCartera from "../components/carteras/TarjetaCartera.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { configuracionCarteras } from "../data/carteras";
import { getTarjetaData } from "../services/finance";
import { generateSVGPath } from "../utils/chart";

export const prerender = false;

const tarjetasData = await Promise.all(
  configuracionCarteras.map(async (configuracion) => {
    const data = await getTarjetaData(configuracion.nombre);
    const chart = generateSVGPath(data.historial50, 320, 60);

    return { ...configuracion, ...data, chart };
  }),
);
---

<MainLayout title="Carteras - Mi Economía" activeTab="carteras">
  <div class="space-y-4">
    {tarjetasData.map((tarjeta) => <TarjetaCartera {...tarjeta} />)}
  </div>
</MainLayout>
