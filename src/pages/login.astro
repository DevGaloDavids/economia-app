---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Iniciar Sesión" activeTab="inicio">
  <div class="max-w-md mx-auto mt-8 bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl">
    <h2 class="text-xl font-bold text-white mb-1 text-center">Bienvenido 👋</h2>
    <p class="text-xs text-slate-400 text-center mb-6">Inicia sesión para gestionar tus finanzas</p>

    <form id="form-auth" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Email</label>
        <input 
          type="email" 
          name="email" 
          required 
          placeholder="tu@email.com" 
          class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-cyan-500 transition-colors"
        />
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Contraseña</label>
        <input 
          type="password" 
          name="password" 
          required 
          placeholder="••••••••" 
          class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-cyan-500 transition-colors"
        />
      </div>

      <div class="pt-2 flex gap-3">
        <button 
          type="submit" 
          id="btn-login" 
          class="flex-1 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold py-2.5 rounded-xl transition text-sm shadow-lg shadow-emerald-950/50"
        >
          Entrar
        </button>
        <button 
          type="button" 
          id="btn-register" 
          class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold py-2.5 rounded-xl transition text-sm border border-slate-700"
        >
          Registrarse
        </button>
      </div>

      <p id="msg-auth" class="text-xs text-center hidden font-semibold pt-2"></p>
    </form>
  </div>
</MainLayout>

<script>
  import { signInWithEmail, signUpWithEmail } from "../lib/auth";

  const form = document.getElementById("form-auth") as HTMLFormElement;
  const btnRegister = document.getElementById("btn-register");
  const msgAuth = document.getElementById("msg-auth");

  const mostrarMensaje = (texto: string, esError = false) => {
    if (!msgAuth) return;
    msgAuth.textContent = texto;
    msgAuth.className = `text-xs text-center block font-semibold pt-2 ${esError ? "text-rose-400" : "text-emerald-400"}`;
  };

  // Iniciar Sesión
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const email = formData.get("email") as string;
    const password = formData.get("password") as string;

    try {
      await signInWithEmail(email, password);
      mostrarMensaje("✓ Sesión iniciada correctamente. Redirigiendo...");
      setTimeout(() => window.location.href = "/", 1000);
    } catch (err: any) {
      mostrarMensaje(`❌ ${err.message}`, true);
    }
  });

  // Registro de usuario
  btnRegister?.addEventListener("click", async () => {
    const formData = new FormData(form);
    const email = formData.get("email") as string;
    const password = formData.get("password") as string;

    if (!email || !password) {
      mostrarMensaje("❌ Introduce email y contraseña para registrarte", true);
      return;
    }

    try {
      await signUpWithEmail(email, password);
      mostrarMensaje("✓ Cuenta creada con éxito. Inicia sesión para acceder.");
    } catch (err: any) {
      mostrarMensaje(`❌ ${err.message}`, true);
    }
  });
</script>