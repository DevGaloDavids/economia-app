---
import TarjetaAcumulado from "../components/acumulados/TarjetaAcumulado.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { getAcumuladoData } from "../services/finance";

export const prerender = false;

const OBJETIVO_SEGUROS = 396;
const OBJETIVO_LENTILLAS = 48;

const { restante: restanteSeguros } = await getAcumuladoData("Seguros");
const { restante: restanteLentillas } = await getAcumuladoData("Lentillas");

const calcularPorcentaje = (restante: number, objetivo: number) =>
  Math.min(Math.max(Math.round((restante / objetivo) * 100), 0), 100);

const pctSeguros = calcularPorcentaje(restanteSeguros, OBJETIVO_SEGUROS);
const pctLentillas = calcularPorcentaje(restanteLentillas, OBJETIVO_LENTILLAS);
---

<MainLayout title="Acumulados - Mi Economía" activeTab="acumulados">
  <div class="space-y-4">
    <div
      style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%;"
    >
      <TarjetaAcumulado
        icono="🛡️"
        nombre="Seguros"
        restante={restanteSeguros}
        objetivo={OBJETIVO_SEGUROS}
        porcentaje={pctSeguros}
        cardBackground="linear-gradient(to bottom right, #0f172a, #1e293b, #0f172a)"
        cardBorder="rgba(59, 130, 246, 0.4)"
        glowColor="rgba(59, 130, 246, 0.15)"
        titleColor="#60a5fa"
        dividerColor="rgba(59, 130, 246, 0.2)"
        labelColor="#93c5fd"
        trackBackground="rgba(30, 41, 59, 0.8)"
        trackBorder="rgba(59, 130, 246, 0.3)"
        progressGradient="linear-gradient(to right, #2563eb, #60a5fa)"
      />
      <TarjetaAcumulado
        icono="👁️"
        nombre="Lentillas"
        restante={restanteLentillas}
        objetivo={OBJETIVO_LENTILLAS}
        porcentaje={pctLentillas}
        cardBackground="linear-gradient(to bottom right, #18181b, #27272a, #09090b)"
        cardBorder="rgba(113, 113, 122, 0.4)"
        glowColor="rgba(161, 161, 170, 0.1)"
        titleColor="#e4e4e7"
        dividerColor="rgba(113, 113, 122, 0.3)"
        labelColor="#d4d4d8"
        trackBackground="rgba(39, 39, 42, 0.8)"
        trackBorder="rgba(113, 113, 122, 0.3)"
        progressGradient="linear-gradient(to right, #52525b, #a1a1aa)"
      />
    </div>
  </div>
</MainLayout>
