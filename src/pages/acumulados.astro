---
import MainLayout from '../layouts/MainLayout.astro';
import { getAcumuladoData } from '../services/finance';
import { formatEuros } from '../utils/formatters';

export const prerender = false;

// Objetivos fijos
const OBJETIVO_SEGUROS = 396;
const OBJETIVO_LENTILLAS = 48;

// Carga de saldos actuales desde BBDD
const { restante: restanteSeguros } = await getAcumuladoData("Seguros");
const { restante: restanteLentillas } = await getAcumuladoData("Lentillas");

// Cálculos de porcentaje de progreso
const pctSeguros = Math.min(Math.max(Math.round((restanteSeguros / OBJETIVO_SEGUROS) * 100), 0), 100);
const pctLentillas = Math.min(Math.max(Math.round((restanteLentillas / OBJETIVO_LENTILLAS) * 100), 0), 100);
---

<MainLayout title="Acumulados - Mi Economía" activeTab="acumulados">
  <div class="space-y-4">

    <!-- GRID EN 2 COLUMNAS -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%;">

      <!-- TARJETA 1: SEGUROS (AZUL OSCURO) -->
      <div style="background: linear-gradient(to bottom right, #0f172a, #1e293b, #0f172a); border: 1px solid rgba(59, 130, 246, 0.4); border-radius: 1.25rem; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; box-sizing: border-box; position: relative;">
        <div style="position: absolute; top: -20px; right: -20px; width: 80px; height: 80px; background: rgba(59, 130, 246, 0.15); border-radius: 9999px; filter: blur(16px); pointer-events: none;"></div>

        <div>
          <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 8px;">
            <span style="font-size: 13px;">🛡️</span>
            <span style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: #60a5fa; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              Seguros
            </span>
          </div>

          <div style="margin-bottom: 12px;">
            <div style={`font-size: 18px; font-weight: 800; ${restanteSeguros >= 0 ? "color: #ffffff;" : "color: #fb7185;"}`}>
              {formatEuros(restanteSeguros)}
            </div>
            <p style="font-size: 9px; color: #94a3b8; margin: 1px 0 0 0;">Acumulado actual</p>
          </div>
        </div>

        <!-- BARRA Y META -->
        <div style="margin-top: 6px; padding-top: 8px; border-top: 1px solid rgba(59, 130, 246, 0.2);">
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 9px; margin-bottom: 4px; color: #93c5fd;">
            <span>Objetivo</span>
            <span style="font-weight: bold; color: #ffffff;">{formatEuros(OBJETIVO_SEGUROS)}</span>
          </div>

          <!-- Barra de progreso -->
          <div style="width: 100%; background: rgba(30, 41, 59, 0.8); height: 6px; border-radius: 9999px; overflow: hidden; border: 1px solid rgba(59, 130, 246, 0.3);">
            <div style={`width: ${pctSeguros}%; background: linear-gradient(to right, #2563eb, #60a5fa); height: 100%; border-radius: 9999px; transition: width 0.3s ease;`}></div>
          </div>
        </div>
      </div>

      <!-- TARJETA 2: LENTILLAS (GRIS) -->
      <div style="background: linear-gradient(to bottom right, #18181b, #27272a, #09090b); border: 1px solid rgba(113, 113, 122, 0.4); border-radius: 1.25rem; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; box-sizing: border-box; position: relative;">
        <div style="position: absolute; top: -20px; right: -20px; width: 80px; height: 80px; background: rgba(161, 161, 170, 0.1); border-radius: 9999px; filter: blur(16px); pointer-events: none;"></div>

        <div>
          <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 8px;">
            <span style="font-size: 13px;">👁️</span>
            <span style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: #e4e4e7; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              Lentillas
            </span>
          </div>

          <div style="margin-bottom: 12px;">
            <div style={`font-size: 18px; font-weight: 800; ${restanteLentillas >= 0 ? "color: #ffffff;" : "color: #fb7185;"}`}>
              {formatEuros(restanteLentillas)}
            </div>
            <p style="font-size: 9px; color: #94a3b8; margin: 1px 0 0 0;">Acumulado actual</p>
          </div>
        </div>

        <!-- BARRA Y META -->
        <div style="margin-top: 6px; padding-top: 8px; border-top: 1px solid rgba(113, 113, 122, 0.3);">
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 9px; margin-bottom: 4px; color: #d4d4d8;">
            <span>Objetivo</span>
            <span style="font-weight: bold; color: #ffffff;">{formatEuros(OBJETIVO_LENTILLAS)}</span>
          </div>

          <!-- Barra de progreso -->
          <div style="width: 100%; background: rgba(39, 39, 42, 0.8); height: 6px; border-radius: 9999px; overflow: hidden; border: 1px solid rgba(113, 113, 122, 0.3);">
            <div style={`width: ${pctLentillas}%; background: linear-gradient(to right, #52525b, #a1a1aa); height: 100%; border-radius: 9999px; transition: width 0.3s ease;`}></div>
          </div>
        </div>
      </div>

    </div>

  </div>
</MainLayout>