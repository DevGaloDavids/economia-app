---
import MainLayout from '../layouts/MainLayout.astro';
import { getGastosFijosData } from '../services/finance';
import { formatEuros } from '../utils/formatters';

export const prerender = false;

// Carga de datos reales desde Supabase
const { estadoGastosFijos, totalEstimado, totalPagado, pendiente } = await getGastosFijosData();

// Evitar división por cero en la barra de porcentaje
const porcentajePagado = totalEstimado > 0 ? Math.round((totalPagado / totalEstimado) * 100) : 0;

// Ordenar: primero los no pagados (pagado === false) y al final los pagados (pagado === true)
const gastosOrdenados = estadoGastosFijos ? [...estadoGastosFijos].sort((a, b) => Number(a.pagado) - Number(b.pagado)) : [];
---

<MainLayout title="Gastos Fijos - Mi Economía" activeTab="otros">
  <div class="space-y-4">

    <!-- TARJETA PRINCIPAL: GASTOS FIJOS (ROJO OSCURO) -->
    <div style="background: linear-gradient(to bottom right, rgba(127, 29, 29, 0.5), #0f172a, #0f172a); border: 1px solid rgba(220, 38, 38, 0.35); border-radius: 1.5rem; padding: 20px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5); position: relative; overflow: hidden;">
      <div style="position: absolute; top: -30px; right: -30px; width: 120px; height: 120px; background: rgba(220, 38, 38, 0.15); border-radius: 9999px; filter: blur(24px); pointer-events: none;"></div>

      <!-- CABECERA TARJETA -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
        <div>
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
            <span style="font-size: 18px;">📅</span>
            <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #f87171;">
              Gastos Fijos del Mes
            </span>
          </div>
          <p style="font-size: 11px; color: #94a3b8; margin: 0;">Suscripciones y cuotas recurrentes</p>
        </div>
        
        <div style="text-align: right;">
          <div style="font-size: 16px; font-weight: 800; color: #ffffff;">
            {formatEuros(pendiente)}
          </div>
          <p style="font-size: 9px; color: #f87171; margin: 0; text-transform: uppercase; font-weight: 600;">
            Pendiente
          </p>
        </div>
      </div>

      <!-- BARRA RESUMEN GLOBAL -->
      <div style="display: flex; justify-content: space-between; font-size: 10px; color: #cbd5e1; margin-bottom: 8px;">
        <span>Pagado: {formatEuros(totalPagado)}</span>
        <span>Total: {formatEuros(totalEstimado)}</span>
      </div>
      <div style="width: 100%; background: rgba(127, 29, 29, 0.3); height: 6px; border-radius: 9999px; margin-bottom: 24px; overflow: hidden;">
        <div style={`width: ${porcentajePagado}%; background: linear-gradient(to right, #dc2626, #ef4444); height: 100%; border-radius: 9999px; transition: width 0.3s ease;`}></div>
      </div>

      <!-- LISTA DE GASTOS REALES ORDENADOS -->
      <div style="display: flex; flex-direction: column; gap: 10px;">
        {gastosOrdenados && gastosOrdenados.length > 0 ? (
          gastosOrdenados.map((gasto) => (
            <div style={`display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: 12px; border: 1px solid ${gasto.pagado ? 'rgba(34, 197, 94, 0.2)' : 'rgba(239, 68, 68, 0.2)'}; background: ${gasto.pagado ? 'rgba(20, 83, 45, 0.2)' : 'rgba(127, 29, 29, 0.15)'};`}>
              
              <div style="display: flex; align-items: center; gap: 10px;">
                <div style={`width: 8px; height: 8px; border-radius: 50%; background-color: ${gasto.pagado ? '#22c55e' : '#ef4444'}; box-shadow: 0 0 8px ${gasto.pagado ? '#22c55e' : '#ef4444'}; shrink-0: 0;`}></div>
                <div>
                  <span style={`font-size: 13px; font-weight: 600; ${gasto.pagado ? 'color: #94a3b8; text-decoration: line-through;' : 'color: #f1f5f9;'}`}>
                    {gasto.concepto}
                  </span>
                  <span style="display: block; font-size: 9px; color: #64748b; margin-top: 1px;">
                    {gasto.categoria}
                  </span>
                </div>
              </div>

              <div style="display: flex; align-items: center; gap: 10px;">
                <span style={`font-weight: 700; font-size: 13px; ${gasto.pagado ? 'color: #94a3b8;' : 'color: #f87171;'}`}>
                  {formatEuros(gasto.importeReal)}
                </span>
                
                {!gasto.pagado ? (
                  <button 
                    type="button" 
                    class="btn-pagar"
                    data-concepto-id={gasto.concepto}
                    style="background: #dc2626; color: white; border: none; padding: 5px 10px; border-radius: 6px; font-size: 10px; font-weight: 600; cursor: pointer; transition: all 0.2s;"
                  >
                    Pagar
                  </button>
                ) : (
                  <span style="font-size: 15px; color: #22c55e; font-weight: bold; width: 45px; text-align: center;">✓</span>
                )}
              </div>

            </div>
          ))
        ) : (
          <p style="font-size: 12px; color: #94a3b8; text-align: center; padding: 12px 0;">
            No se encontraron gastos fijos registrados.
          </p>
        )}
      </div>

    </div>

  </div>

  <style>
    .btn-pagar:hover {
      background: #ef4444 !important;
      transform: scale(1.05);
    }
    .btn-pagar:active {
      transform: scale(0.95);
    }
    .btn-pagar:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none !important;
    }
  </style>

  <script>
    import { marcarGastoFijoComoPagado } from '../services/mutations';

    document.querySelectorAll('.btn-pagar').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const conceptoId = target.dataset.conceptoId;

        if (!conceptoId) return;

        const textoOriginal = target.innerText;
        target.innerText = '...';
        target.disabled = true;

        try {
          await marcarGastoFijoComoPagado(conceptoId, true);
          window.location.reload();
        } catch (error: any) {
          console.error('Error al pagar:', error);
          alert(`Error al marcar como pagado ${conceptoId}: ${error.message || 'Inténtalo de nuevo'}`);
          target.innerText = textoOriginal;
          target.disabled = false;
        }
      });
    });
  </script>

</MainLayout>