---
import PanelGastosFijos from "../components/fijos/PanelGastosFijos.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { getGastosFijosData } from "../services/finance";

export const prerender = false;

const { estadoGastosFijos, totalEstimado, totalPagado, pendiente } =
  await getGastosFijosData();

const porcentajePagado =
  totalEstimado > 0 ? Math.round((totalPagado / totalEstimado) * 100) : 0;

const gastosOrdenados = estadoGastosFijos
  ? [...estadoGastosFijos].sort(
      (a, b) => Number(a.pagado) - Number(b.pagado),
    )
  : [];
---

<MainLayout title="Gastos Fijos - Mi Economía" activeTab="otros">
  <div class="space-y-4">
    <PanelGastosFijos
      gastos={gastosOrdenados}
      totalEstimado={totalEstimado}
      totalPagado={totalPagado}
      pendiente={pendiente}
      porcentajePagado={porcentajePagado}
    />
  </div>
</MainLayout>
