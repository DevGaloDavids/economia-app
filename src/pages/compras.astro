---
import TarjetaCompras from "../components/compras/TarjetaCompras.astro";
import TarjetaDesgloseTransporte from "../components/compras/TarjetaDesgloseTransporte.astro";
import TarjetaAvisoCompra from "../components/compras/TarjetaAvisoCompra.astro";
import MainLayout from "../layouts/MainLayout.astro";
import {
  getComprasData,
  getTransporteData,
  getAcumuladoData,
} from "../services/finance";

export const prerender = false;

const { restanteCompras, porcentajes: porcentajesCompras } = await getComprasData();
const { restanteTransporte, porcentajes } = await getTransporteData();
const { restante: restanteBarberia } = await getAcumuladoData("Barberia");
const { restante: restanteLimpieza } = await getAcumuladoData("Limpieza");
---

<MainLayout title="Compras - Mi Economía" activeTab="compras">
  <div class="space-y-4">
    <TarjetaCompras
      restante={restanteCompras}
      porcentajes={porcentajesCompras}
    />
    <TarjetaDesgloseTransporte
      restante={restanteTransporte}
      porcentajes={porcentajes}
    />
  </div>

  <div
    style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; width: 100%;"
  >
    <TarjetaAvisoCompra
      icono="💈"
      nombre="Barbería"
      restante={restanteBarberia}
      tituloAviso="Sacar efectivo"
      mensaje="Llevar metálico antes de ir."
      cardStyle="background: linear-gradient(to bottom right, #09090b, #18181b, #000000); border: 1px solid rgba(63, 63, 70, 0.6);"
      colorNombre="#d4d4d8"
      colorAviso="#f59e0b"
      borderStyle="border-top: 1px solid rgba(63, 63, 70, 0.4);"
    />
    <TarjetaAvisoCompra
      icono="🧹"
      nombre="Limpieza"
      restante={restanteLimpieza}
      tituloAviso="Aviso"
      mensaje="Sacar antes del último martes de mes."
      cardStyle="background: linear-gradient(to bottom right, rgba(120, 53, 15, 0.4), #0f172a, #0f172a); border: 1px solid rgba(245, 158, 11, 0.4);"
      colorNombre="#fbbf24"
      colorAviso="#fbbf24"
      borderStyle="border-top: 1px solid rgba(245, 158, 11, 0.2);"
      mensajeColor="#cbd5e1"
    />
  </div>
</MainLayout>
