---
import MainLayout from '../layouts/MainLayout.astro';
import { getLuzData, getAguaData } from '../services/finance';
import { formatEuros } from '../utils/formatters';

export const prerender = false;

const { restante: restanteLuz, historiaGrafica: historiaLuz } = await getLuzData();
const { restante: restanteAgua, historiaGrafica: historiaAgua } = await getAguaData();
---

<MainLayout title="Servicios - Mi Economía" activeTab="servicios">
  <div class="space-y-4">

    <!-- 1. TARJETA LARGA: LUZ (AMARILLO) -->
    <div style="background: linear-gradient(to bottom right, rgba(113, 63, 18, 0.4), #0f172a, #0f172a); border: 1px solid rgba(234, 179, 8, 0.35); border-radius: 1.5rem; padding: 20px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5); position: relative; overflow: hidden;">
      <div style="position: absolute; top: -30px; right: -30px; width: 120px; height: 120px; background: rgba(234, 179, 8, 0.12); border-radius: 9999px; filter: blur(24px); pointer-events: none;"></div>

      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 18px;">💡</span>
          <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #fde047;">
            Servicio de Luz
          </span>
        </div>
        <span style="font-size: 10px; background: rgba(234, 179, 8, 0.15); color: #fef08a; padding: 4px 10px; border-radius: 9999px; border: 1px solid rgba(234, 179, 8, 0.3); font-weight: 600;">
          Acumulado
        </span>
      </div>

      <div style="margin-bottom: 20px;">
        <div style={`font-size: 28px; font-weight: 800; ${restanteLuz >= 0 ? "color: #ffffff;" : "color: #fb7185;"}`}>
          {formatEuros(restanteLuz)}
        </div>
        <p style="font-size: 11px; color: #94a3b8; margin: 2px 0 0 0;">Saldo restante disponible</p>
      </div>

      <!-- GRÁFICA DE BARRAS (ÚLTIMOS 6 MESES) -->
      <div style="padding-top: 14px; border-top: 1px solid rgba(234, 179, 8, 0.2);">
        <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #fde047; display: block; margin-bottom: 14px;">
          Gasto mensual (Últimos 6 meses)
        </span>

        <div style="display: flex; align-items: flex-end; justify-content: space-between; height: 110px; padding: 0 4px; gap: 8px;">
          {historiaLuz.map((m) => (
            <div style="display: flex; flex-direction: column; align-items: center; flex: 1; height: 100%; justify-content: flex-end;">
              <span style="font-size: 9px; color: #cbd5e1; font-weight: 600; margin-bottom: 4px;">
                {m.gasto > 0 ? `${Math.round(m.gasto)}€` : '0€'}
              </span>
              <div style="width: 100%; max-width: 28px; background: rgba(253, 224, 71, 0.15); border-radius: 6px 6px 0 0; height: 80px; display: flex; align-items: flex-end; overflow: hidden;">
                <div style={`width: 100%; height: ${Math.max(m.porcentajeAltura, 6)}%; background: linear-gradient(to top, #ca8a04, #fde047); border-radius: 4px 4px 0 0; transition: height 0.3s ease;`}></div>
              </div>
              <span style="font-size: 9px; color: #94a3b8; margin-top: 6px; font-weight: 500;">
                {m.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- 2. TARJETA LARGA: AGUA (AZUL CLARO) -->
    <div style="background: linear-gradient(to bottom right, rgba(12, 74, 110, 0.4), #0f172a, #0f172a); border: 1px solid rgba(56, 189, 248, 0.35); border-radius: 1.5rem; padding: 20px; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5); position: relative; overflow: hidden;">
      <div style="position: absolute; top: -30px; right: -30px; width: 120px; height: 120px; background: rgba(56, 189, 248, 0.12); border-radius: 9999px; filter: blur(24px); pointer-events: none;"></div>

      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <span style="font-size: 18px;">💧</span>
          <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #38bdf8;">
            Servicio de Agua
          </span>
        </div>
        <span style="font-size: 10px; background: rgba(56, 189, 248, 0.15); color: #bae6fd; padding: 4px 10px; border-radius: 9999px; border: 1px solid rgba(56, 189, 248, 0.3); font-weight: 600;">
          Acumulado
        </span>
      </div>

      <div style="margin-bottom: 20px;">
        <div style={`font-size: 28px; font-weight: 800; ${restanteAgua >= 0 ? "color: #ffffff;" : "color: #fb7185;"}`}>
          {formatEuros(restanteAgua)}
        </div>
        <p style="font-size: 11px; color: #94a3b8; margin: 2px 0 0 0;">Saldo restante disponible</p>
      </div>

      <!-- GRÁFICA DE BARRAS (ÚLTIMOS 6 MESES) -->
      <div style="padding-top: 14px; border-top: 1px solid rgba(56, 189, 248, 0.2);">
        <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #38bdf8; display: block; margin-bottom: 14px;">
          Gasto mensual (Últimos 6 meses)
        </span>

        <div style="display: flex; align-items: flex-end; justify-content: space-between; height: 110px; padding: 0 4px; gap: 8px;">
          {historiaAgua.map((m) => (
            <div style="display: flex; flex-direction: column; align-items: center; flex: 1; height: 100%; justify-content: flex-end;">
              <span style="font-size: 9px; color: #cbd5e1; font-weight: 600; margin-bottom: 4px;">
                {m.gasto > 0 ? `${Math.round(m.gasto)}€` : '0€'}
              </span>
              <div style="width: 100%; max-width: 28px; background: rgba(56, 189, 248, 0.15); border-radius: 6px 6px 0 0; height: 80px; display: flex; align-items: flex-end; overflow: hidden;">
                <div style={`width: 100%; height: ${Math.max(m.porcentajeAltura, 6)}%; background: linear-gradient(to top, #0284c7, #38bdf8); border-radius: 4px 4px 0 0; transition: height 0.3s ease;`}></div>
              </div>
              <span style="font-size: 9px; color: #94a3b8; margin-top: 6px; font-weight: 500;">
                {m.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</MainLayout>