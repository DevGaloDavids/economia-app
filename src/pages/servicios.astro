---
import TarjetaServicio from "../components/servicios/TarjetaServicio.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { getLuzData, getAguaData } from "../services/finance";

export const prerender = false;

const { restante: restanteLuz, historiaGrafica: historiaLuz } =
  await getLuzData();
const { restante: restanteAgua, historiaGrafica: historiaAgua } =
  await getAguaData();
---

<MainLayout title="Servicios - Mi Economía" activeTab="servicios">
  <div class="space-y-4">
    <TarjetaServicio
      icono="💡"
      nombre="Servicio de Luz"
      restante={restanteLuz}
      historia={historiaLuz}
      cardBackground="linear-gradient(to bottom right, rgba(113, 63, 18, 0.4), #0f172a, #0f172a)"
      borderColor="rgba(234, 179, 8, 0.35)"
      glowColor="rgba(234, 179, 8, 0.12)"
      titleColor="#fde047"
      badgeBackground="rgba(234, 179, 8, 0.15)"
      badgeColor="#fef08a"
      badgeBorderColor="rgba(234, 179, 8, 0.3)"
      chartBorderColor="rgba(234, 179, 8, 0.2)"
      barBackground="rgba(253, 224, 71, 0.15)"
      barGradient="linear-gradient(to top, #ca8a04, #fde047)"
    />
    <TarjetaServicio
      icono="💧"
      nombre="Servicio de Agua"
      restante={restanteAgua}
      historia={historiaAgua}
      cardBackground="linear-gradient(to bottom right, rgba(12, 74, 110, 0.4), #0f172a, #0f172a)"
      borderColor="rgba(56, 189, 248, 0.35)"
      glowColor="rgba(56, 189, 248, 0.12)"
      titleColor="#38bdf8"
      badgeBackground="rgba(56, 189, 248, 0.15)"
      badgeColor="#bae6fd"
      badgeBorderColor="rgba(56, 189, 248, 0.3)"
      chartBorderColor="rgba(56, 189, 248, 0.2)"
      barBackground="rgba(56, 189, 248, 0.15)"
      barGradient="linear-gradient(to top, #0284c7, #38bdf8)"
    />
  </div>
</MainLayout>
