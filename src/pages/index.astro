---
import { createClient } from "@supabase/supabase-js";

// Leer las variables de entorno del proyecto
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

// Consultar los datos de Supabase
const { data, error } = await supabase.from("cuentas").select("*");
const cuentas = data || [];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Mi Economía</title>

		<!-- Configuración PWA -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#0f172a" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
	</head>
	<body class="bg-slate-900 text-white p-6 font-sans">
		<div class="max-w-md mx-auto">
			<h1 class="text-2xl font-bold text-emerald-400 mb-4">
				💳 Mi Economía Personal
			</h1>
			<p class="text-slate-400 mb-6">Hello World desde Supabase:</p>

			<div class="space-y-3">
				{
					cuentas.map((cuenta) => (
						<div class="bg-slate-800 p-4 rounded-xl border border-slate-700 flex justify-between items-center">
							<span class="font-medium text-slate-200">
								{cuenta.nombre}
							</span>
							<span class="font-bold text-emerald-400">
								{cuenta.saldo_actual} €
							</span>
						</div>
					))
				}
			</div>
		</div>
	</body>
</html>
