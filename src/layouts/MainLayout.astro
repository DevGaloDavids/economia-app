---
import "../styles/global.css";
import AppHeader from "../components/layout/AppHeader.astro";
import TopNavigation from "../components/layout/TopNavigation.astro";
import BottomNavigation from "../components/layout/BottomNavigation.astro";
import NuevoRegistroModal from "../components/NuevoRegistroModal.astro";
import NuevoMovimientoModal from "../components/NuevoMovimientoModal.astro";
import ModalReparto from "../components/ModalReparto.astro";
import ModalGestionMovimientos from "../components/ModalGestionMovimientos.astro";

interface Props {
  title?: string;
  activeTab:
    | "inicio"
    | "carteras"
    | "compras"
    | "servicios"
    | "acumulados"
    | "otros";
}

const { title = "Mi Economía", activeTab } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>{title}</title>

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#090d16" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
  </head>
  <body
    class="bg-[#090d16] text-slate-100 font-sans antialiased min-h-screen pb-28 select-none"
  >
    <div class="max-w-md mx-auto px-4 pt-6 space-y-5">
      <AppHeader />
      <TopNavigation activeTab={activeTab} />

      <main class="space-y-5">
        <slot />
      </main>
    </div>

    <BottomNavigation />

    <NuevoRegistroModal />
    <NuevoMovimientoModal />
    <ModalReparto />
    <ModalGestionMovimientos />

    <script src="../scripts/main-layout.ts"></script>
  </body>
</html>
