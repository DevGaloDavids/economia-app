---
import { formatEuros } from "../../utils/formatters";
import type { getPrestamoMotoData } from "../../services/finance";

type PrestamoMoto = Awaited<ReturnType<typeof getPrestamoMotoData>>;

interface Props {
  prestamo: PrestamoMoto;
}

const { prestamo } = Astro.props;
---

<section class="relative overflow-hidden rounded-3xl border border-cyan-800/40 bg-gradient-to-br from-cyan-950/40 via-slate-900 to-slate-900 p-6 shadow-xl">
  <div class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-cyan-500/15 blur-2xl"></div>

  <div class="relative">
    <div class="mb-5 flex items-start justify-between gap-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-cyan-300">
          Préstamo de la moto
        </p>
        <p class="mt-1 text-xs text-slate-400">Seguimiento de cuotas y deuda</p>
      </div>
      <span class="rounded-full border border-cyan-500/30 bg-cyan-500/15 px-2.5 py-1 text-xs font-medium text-cyan-200">
        🏍️ Moto
      </span>
    </div>

    <div class="mb-5">
      <p class="mb-1 text-xs text-slate-400">Deuda pendiente</p>
      <p
        class="monto-privado font-mono text-3xl font-extrabold tracking-tight text-white"
        data-valor={formatEuros(prestamo.deudaPendiente)}
      >
        {formatEuros(prestamo.deudaPendiente)}
      </p>
    </div>

    <div class="mb-5 grid grid-cols-2 gap-3">
      <div class="rounded-2xl border border-slate-700/70 bg-slate-950/40 p-3">
        <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-500">
          Importe inicial
        </p>
        <p
          class="monto-privado font-mono text-sm font-bold text-slate-100"
          data-valor={formatEuros(prestamo.importeInicial)}
        >
          {formatEuros(prestamo.importeInicial)}
        </p>
      </div>
      <div class="rounded-2xl border border-slate-700/70 bg-slate-950/40 p-3">
        <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-500">
          Cuotas restantes
        </p>
        <p class="font-mono text-sm font-bold text-slate-100">
          {prestamo.cuotasRestantes} <span class="text-slate-500">/ {prestamo.cuotasTotales}</span>
        </p>
      </div>
    </div>

    <div class="border-t border-cyan-900/50 pt-4">
      <div class="mb-2 flex justify-between gap-3 text-xs">
        <span class="text-slate-300">
          {prestamo.cuotasPagadas} {prestamo.cuotasPagadas === 1 ? "cuota pagada" : "cuotas pagadas"}
        </span>
        <span class="font-semibold text-cyan-300">{prestamo.porcentajePagado}%</span>
      </div>
      <div
        class="mb-3 h-2 overflow-hidden rounded-full bg-slate-800"
        role="progressbar"
        aria-label="Progreso de cuotas pagadas"
        aria-valuemin="0"
        aria-valuemax={prestamo.cuotasTotales}
        aria-valuenow={Math.min(prestamo.cuotasPagadas, prestamo.cuotasTotales)}
      >
        <div
          class="h-full rounded-full bg-gradient-to-r from-cyan-600 to-cyan-300 transition-[width]"
          style={`width: ${prestamo.porcentajePagado}%`}
        >
        </div>
      </div>
      <div class="flex justify-between gap-3 text-[11px]">
        <span class="text-slate-500">Pagado: <span
            class="monto-privado font-mono text-slate-300"
            data-valor={formatEuros(prestamo.importePagado)}
          >{formatEuros(prestamo.importePagado)}</span
        ></span>
        <span class="text-right text-slate-500">Total: {prestamo.cuotasTotales} cuotas</span>
      </div>
    </div>
  </div>
</section>
