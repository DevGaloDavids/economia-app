---
import type { ConfiguracionCartera } from "../../data/carteras";
import { formatEuros } from "../../utils/formatters";
import type { generateSVGPath } from "../../utils/chart";

interface Props extends ConfiguracionCartera {
  saldoActual: number;
  historial50: { importe: number; fecha: string; comparison?: number }[];
  chart: ReturnType<typeof generateSVGPath>;
  gestionable?: boolean;
  tipoGestion?: "cuenta" | "inversion";
  totalInvertido?: number;
}

const {
  nombre,
  icono,
  gradientClass,
  glowClass,
  textClass,
  badgeClass,
  strokeColor,
  stopColor,
  gradId,
  saldoActual,
  historial50,
  chart,
  gestionable = true,
  tipoGestion = "cuenta",
  totalInvertido,
} = Astro.props;

const saldoFormateado = formatEuros(saldoActual);
const invertidoFormateado =
  totalInvertido === undefined ? undefined : formatEuros(totalInvertido);
const nombreSeguro = JSON.stringify(nombre);
---

<div
  onclick={gestionable ? `window.abrirModalGestion && window.abrirModalGestion(${nombreSeguro}, '${tipoGestion}')` : undefined}
  class={`bg-gradient-to-br ${gradientClass} border rounded-3xl p-6 shadow-2xl relative overflow-hidden ${gestionable ? "cursor-pointer" : ""} hover:brightness-110 transition-all duration-200 active:scale-[0.99]`}
>
  <div
    class={`absolute -top-10 -right-10 w-32 h-32 ${glowClass} rounded-full blur-2xl pointer-events-none`}
  >
  </div>

  <div class="flex justify-between items-start mb-3">
    <div class="flex items-center gap-2">
      <span class="text-base">{icono}</span>
      <span class={`text-xs font-semibold uppercase tracking-wider ${textClass}`}>
        {nombre}
      </span>
    </div>
    <span
      class={`text-[10px] px-2.5 py-1 rounded-full border font-medium ${badgeClass}`}
    >
      Últimos 50 registros
    </span>
  </div>

  <div class="mb-4">
    <div
      class="monto-privado text-3xl font-extrabold text-white font-mono"
      data-valor={saldoFormateado}
    >
      {saldoFormateado}
    </div>
    <p class="text-[11px] text-slate-400">Saldo actual disponible</p>
  </div>

  {
    historial50.length > 1 ? (
      <div class="pt-2 border-t border-slate-800/80 relative">
        {chart.comparisonPath && (
          <div class="flex gap-4 mb-1 text-[10px] text-slate-400">
            <span class="flex items-center gap-1.5">
              <span
                class="w-2 h-2 rounded-full"
                style={`background-color: ${strokeColor}`}
              />
              Valor de cartera
            </span>
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-white" />
              Total invertido
            </span>
          </div>
        )}
        <svg viewBox="0 0 320 60" class="w-full h-16 overflow-visible">
          <defs>
            <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color={stopColor} stop-opacity="0.35" />
              <stop offset="100%" stop-color={stopColor} stop-opacity="0.0" />
            </linearGradient>
          </defs>

          <path d={chart.areaPath} fill={`url(#${gradId})`} />
          <path
            d={chart.path}
            fill="none"
            stroke={strokeColor}
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          {chart.comparisonPath && (
            <path
              d={chart.comparisonPath}
              fill="none"
              stroke="#ffffff"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          )}

          {chart.lastPoint && (
            <circle
              cx={chart.lastPoint.x}
              cy={chart.lastPoint.y}
              r="4"
              fill={strokeColor}
              class="animate-pulse"
            />
          )}
          {chart.comparisonLastPoint && (
            <circle
              cx={chart.comparisonLastPoint.x}
              cy={chart.comparisonLastPoint.y}
              r="3"
              fill="#ffffff"
            />
          )}
        </svg>
        {invertidoFormateado && (
          <p class="text-[10px] text-slate-400 text-right mt-1">
            Total invertido: <span class="text-white font-mono">{invertidoFormateado}</span>
          </p>
        )}
      </div>
    ) : (
      <p class="text-xs text-slate-500 pt-3 border-t border-slate-800/80">
        Se necesitan al menos 2 registros para la gráfica
      </p>
    )
  }
</div>
