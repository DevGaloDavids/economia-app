---
import { getTransporteData } from "../../services/finance";
import { formatEuros } from "../../utils/formatters";

interface Props {
  restante: number;
  porcentajes: Awaited<ReturnType<typeof getTransporteData>>["porcentajes"];
}

const { restante, porcentajes } = Astro.props;
---

<div
  onclick="window.abrirModalGestion && window.abrirModalGestion('Transporte')"
  class="bg-gradient-to-br from-orange-950/40 via-slate-900 to-slate-900 border border-orange-800/40 rounded-3xl p-6 shadow-2xl relative overflow-hidden cursor-pointer hover:border-orange-600/60 transition-all duration-200 active:scale-[0.99]"
>
  <div
    class="absolute -top-10 -right-10 w-32 h-32 bg-orange-500/15 rounded-full blur-2xl pointer-events-none"
  >
  </div>

  <div class="flex justify-between items-start mb-3">
    <div class="flex items-center gap-2">
      <span class="text-base">🚗</span>
      <span class="text-xs font-semibold uppercase tracking-wider text-orange-400">
        Transporte
      </span>
    </div>
    <span
      class="text-[10px] bg-orange-500/15 text-orange-300 px-2.5 py-1 rounded-full border border-orange-500/30 font-medium"
    >
      Presupuesto
    </span>
  </div>

  <div class="mb-5">
    <div
      class={`text-3xl font-extrabold ${restante >= 0 ? "text-white" : "text-rose-400"}`}
    >
      {formatEuros(restante)}
    </div>
    <p class="text-[11px] text-slate-400">Restante disponible para transporte</p>
  </div>

  <div class="pt-3 border-t border-orange-900/40 space-y-2.5">
    <div class="flex justify-between items-center text-xs">
      <span class="text-slate-200 font-medium">⛽ Gasolina</span>
      <span class="font-semibold text-orange-400">{porcentajes.gasolina}%</span>
    </div>
    <div class="flex justify-between items-center text-xs">
      <span class="text-slate-200 font-medium">🚌 Público</span>
      <span class="font-semibold text-orange-400">{porcentajes.transporte}%</span>
    </div>
    <div class="flex justify-between items-center text-xs">
      <span class="text-slate-200 font-medium">🛵 Motos</span>
      <span class="font-semibold text-orange-400">{porcentajes.motos_bicis}%</span>
    </div>
    <div class="flex justify-between items-center text-xs">
      <span class="text-slate-200 font-medium">🧼 Limpieza</span>
      <span class="font-semibold text-orange-400">{porcentajes.limpiezas}%</span>
    </div>
  </div>
</div>
