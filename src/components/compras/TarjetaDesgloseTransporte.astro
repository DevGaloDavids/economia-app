---
import { getTransporteData } from "../../services/finance";
import { formatEuros } from "../../utils/formatters";

interface Props {
  restante: number;
  porcentajes: Awaited<ReturnType<typeof getTransporteData>>["porcentajes"];
}

const { restante, porcentajes } = Astro.props;
---

<div
  onclick="window.abrirModalGestion && window.abrirModalGestion('Transporte')"
  style="background: linear-gradient(to bottom right, rgba(67, 20, 7, 0.5), #0f172a, #0f172a); border: 1px solid rgba(234, 88, 12, 0.3); border-radius: 1.25rem; padding: 14px; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; box-sizing: border-box; cursor: pointer; transition: all 0.2s;"
  class="hover:border-orange-500/60 active:scale-[0.99]"
>
  <div>
    <div
      style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;"
    >
      <div style="display: flex; align-items: center; gap: 6px;">
        <span style="font-size: 13px;">🚗</span>
        <span
          style="font-size: 10px; font-weight: bold; text-transform: uppercase; letter-spacing: 0.05em; color: #fb923c; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"
        >
          Transporte
        </span>
      </div>
      <span style="font-size: 10px; color: rgba(251, 146, 60, 0.7);">⚙️</span>
    </div>

    <div style="margin-bottom: 12px;">
      <div
        style={`font-size: 18px; font-weight: 800; ${restante >= 0 ? "color: #ffffff;" : "color: #fb7185;"}`}
      >
        {formatEuros(restante)}
      </div>
      <p style="font-size: 9px; color: #94a3b8; margin: 0;">Restante</p>
    </div>
  </div>

  <div
    style="margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(234, 88, 12, 0.2); font-size: 10px; display: flex; flex-direction: column; gap: 4px;"
  >
    <div
      style="display: flex; justify-content: space-between; align-items: center; color: #cbd5e1;"
    >
      <span style="display: flex; align-items: center; gap: 4px;">⛽ Gasolina</span>
      <span style="font-weight: bold; color: #fb923c;"
        >{porcentajes.gasolina}%</span
      >
    </div>
    <div
      style="display: flex; justify-content: space-between; align-items: center; color: #cbd5e1;"
    >
      <span style="display: flex; align-items: center; gap: 4px;">🚌 Público</span>
      <span style="font-weight: bold; color: #fb923c;"
        >{porcentajes.transporte}%</span
      >
    </div>
    <div
      style="display: flex; justify-content: space-between; align-items: center; color: #cbd5e1;"
    >
      <span style="display: flex; align-items: center; gap: 4px;">🛵 Motos</span>
      <span style="font-weight: bold; color: #fb923c;"
        >{porcentajes.motos_bicis}%</span
      >
    </div>
    <div
      style="display: flex; justify-content: space-between; align-items: center; color: #cbd5e1;"
    >
      <span style="display: flex; align-items: center; gap: 4px;">🧼 Limpieza</span>
      <span style="font-weight: bold; color: #fb923c;"
        >{porcentajes.limpiezas}%</span
      >
    </div>
  </div>
</div>
